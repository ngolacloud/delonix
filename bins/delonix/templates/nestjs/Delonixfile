# Delonixfile — same grammar as a Dockerfile. Build with:
#   delonix build -t __NAME__:dev .
#
# Two stages. The build stage installs every dependency, compiles with the
# Nest CLI and prunes to the production dependencies; the runtime stage takes
# those and the compiled dist/ — no TypeScript, CLI, test, lint tooling or
# package manager in the image. The build context is filtered by .dockerignore (.env, node_modules,
# .git never reach a layer).
# The runtime is distroless/nodejs22, so the build stage MUST be Node 22: the
# node_modules (and any native addon) are pinned to the Node 22 ABI.
FROM node:22-slim AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 CI=true
WORKDIR /app
# pnpm at the version pinned in package.json ("packageManager").
RUN corepack enable
COPY . /app
# From the lock when the project has one (reproducible); a fresh project
# without pnpm-lock.yaml resolves now. Commit pnpm-lock.yaml: see the README.
RUN --mount=type=cache,target=/pnpm/store if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile --store-dir /pnpm/store; else pnpm install --store-dir /pnpm/store; fi
# Drop the dev dependencies here, so the runtime stage needs no package manager.
RUN pnpm build && pnpm prune --prod

# Distroless/nodejs22: just the Node 22 runtime, the CA roots and a pre-created
# nonroot user (uid 65532) — no shell, no npm/pnpm, no apt. The token
# __DISTROLESS_REGISTRY__ is substituted by the scaffold (default
# gcr.io/distroless), with a conventional fallback (node:22-slim) if it cannot
# be pulled.
FROM __DISTROLESS_REGISTRY__/nodejs22-debian12:nonroot
ENV NODE_ENV=production APP_ENV=production
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
ARG VERSION=dev
ENV APP_VERSION=${VERSION}
EXPOSE __PORT__
# No shell in distroless: the healthcheck is exec-form (a JSON array, run WITHOUT
# a shell) and calls node by absolute path. The runtime probes liveness;
# readiness is for the load balancer.
HEALTHCHECK CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:__PORT__/api/v1/health/live').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
STOPSIGNAL SIGTERM
# distroless/nodejs ships the nonroot user (uid 65532); numeric uid:gid needs no
# /etc/passwd entry, so it also holds on the conventional fallback base. The
# process owns nothing under /app and writes only to the manifest's tmpfs.
USER 65532:65532
# distroless/nodejs sets ENTRYPOINT=["/nodejs/bin/node"]; declared explicitly so
# the node path is unambiguous and the CMD carries only the arguments. The
# instrumentation is loaded before the application (see src/instrumentation.ts);
# node is PID 1 directly, so SIGTERM reaches the ordered shutdown in dist/main.js.
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["--require", "./dist/instrumentation.js", "dist/main.js"]
