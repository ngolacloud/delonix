# Delonixfile — same grammar as a Dockerfile. Build with:
#   delonix build -t __NAME__:dev .
#
# Two stages: the first installs every dependency and runs `next build`; the
# second carries only .next/standalone — server.js, the traced production
# node_modules and the browser assets (`pnpm build` copies .next/static into
# it). No package manager and no source reach the runtime image. The build
# context is filtered by .dockerignore (node_modules, .next, .env, .git).
#
# Dependencies come from pnpm-lock.yaml when the project has one (commit it:
# that is what makes two builds of the same commit install the same thing).
# A fresh project has no lock yet, so the build resolves and says so.
# The runtime is distroless/nodejs22, so the build stage MUST be Node 22: the
# traced standalone node_modules (and any native addon) are pinned to the Node
# 22 ABI the distroless image ships.
FROM node:22-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN corepack enable
COPY . .
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; \
    else echo "WARNING: no pnpm-lock.yaml - resolving versions now; run 'pnpm install' and commit the lock" && pnpm install --no-frozen-lockfile; fi
RUN pnpm build

# Distroless/nodejs22: just the Node 22 runtime, the CA roots and a pre-created
# nonroot user (uid 65532) — no shell, no npm/pnpm, no apt. The token
# __DISTROLESS_REGISTRY__ is substituted by the scaffold (default
# gcr.io/distroless), with a conventional fallback (node:22-slim) if it cannot
# be pulled.
FROM __DISTROLESS_REGISTRY__/nodejs22-debian12:nonroot
# NEXT_MANUAL_SIG_HANDLE: the service's own ordered shutdown handles SIGTERM
# (docs/adr/0003-shutdown.md). HOSTNAME: server.js binds to it, and a
# container runtime otherwise sets it to the container's own name.
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 NEXT_MANUAL_SIG_HANDLE=true HOSTNAME=0.0.0.0 PORT=__PORT__
WORKDIR /app
COPY --from=build /app/.next/standalone ./
ARG VERSION=dev
ENV APP_VERSION=${VERSION}
EXPOSE __PORT__
# No shell in distroless: the healthcheck is exec-form (a JSON array, run WITHOUT
# a shell) and calls node by absolute path. The runtime probes liveness;
# readiness is for the load balancer.
HEALTHCHECK CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:__PORT__/api/v1/health/live').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
STOPSIGNAL SIGTERM
# distroless/nodejs ships the nonroot user (uid 65532); numeric uid:gid needs no
# /etc/passwd entry, so it also holds on the conventional fallback base. The
# process owns nothing under /app and writes only to the manifest's tmpfs.
USER 65532:65532
# distroless/nodejs sets ENTRYPOINT=["/nodejs/bin/node"]; declared explicitly so
# the node path is unambiguous and the CMD carries only server.js. node is PID 1
# directly, so SIGTERM reaches the ordered shutdown.
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["server.js"]
