{
  "name": "vmfile",
  "displayName": "Vmfile (delonix)",
  "description": "Syntax highlighting for Vmfile (also spelled VMfile) — delonix's recipe for a bootable VM image.",
  "version": "0.2.0",
  "publisher": "delonix",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vmfile",
        "aliases": [
          "Vmfile",
          "VMfile",
          "vmfile"
        ],
        "filenames": [
          "Vmfile",
          "VMfile"
        ],
        "filenamePatterns": [
          "Vmfile.*",
          "VMfile.*",
          "*.Vmfile",
          "*.VMfile",
          "*.vmfile"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vmfile",
        "scopeName": "source.vmfile",
        "path": "./syntaxes/vmfile.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.shellscript": "shellscript"
        }
      }
    ]
  }
}
